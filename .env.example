# رابط اتصال PostgreSQL — انسخ هذا الملف إلى .env وضع رابط قاعدتك
# مثال محلي:     postgresql://postgres:password@localhost:5432/sultan_crm
# مثال Supabase: postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
DATABASE_URL="postgresql://user:password@host:5432/sultan_crm"

# المساعد الذكي (Kimi / Moonshot AI) — يُقرأ على الخادم فقط ولا يصل للمتصفح
# أنشئ مفتاحاً من: https://platform.kimi.ai
KIMI_API_KEY=""
# النموذج والرابط — اختياريان (القيم الافتراضية معروضة)
KIMI_MODEL="kimi-k2.6"
KIMI_BASE_URL="https://api.moonshot.ai/v1"

# تخزين مقاطع الصوت (Vercel Blob) — يُضبط تلقائياً على Vercel عند ربط مخزن Blob بالمشروع
# (Dashboard → Storage → Create Database → Blob → Connect). محلياً: vercel env pull
BLOB_READ_WRITE_TOKEN=""
